# ============================================
# AI GOLF SWING PLATFORM - ENVIRONMENT CONFIG
# ============================================

# APPLICATION
APP_NAME=Golf Swing AI Platform
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# SERVER
HOST=0.0.0.0
PORT=8000

# DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/golf_swing_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# REDIS
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT AUTHENTICATION
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# BACKBLAZE B2 STORAGE
B2_APPLICATION_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-app-key
B2_BUCKET_NAME=your-bucket-name
B2_BUCKET_ID=your-bucket-id

# FILE UPLOAD LIMITS
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=15
ALLOWED_IMAGE_TYPES=image/jpeg,image/png
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime

# SENDGRID EMAIL
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourgolfapp.com
SENDGRID_FROM_NAME=Golf Swing AI

# EMAIL TEMPLATE IDS
SENDGRID_WELCOME_TEMPLATE=d-your-template-id
SENDGRID_UPLOAD_CONFIRM_TEMPLATE=d-your-template-id
SENDGRID_ANALYSIS_COMPLETE_TEMPLATE=d-your-template-id
SENDGRID_COACH_APPROVAL_TEMPLATE=d-your-template-id
SENDGRID_DISCOUNT_EARNED_TEMPLATE=d-your-template-id

# YOUTUBE API
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:8000/auth/youtube/callback

# TIKTOK API
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=http://localhost:8000/auth/tiktok/callback

# DISCOUNT CODES
DISCOUNT_CODE_PREFIX=GOLF2024
DISCOUNT_PERCENTAGE=15
DISCOUNT_VALIDITY_DAYS=30

# CELERY WORKERS
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIMEOUT=300
CELERY_MAX_RETRIES=3

# MEDIAPIPE
MEDIAPIPE_MIN_DETECTION_CONFIDENCE=0.5
MEDIAPIPE_MIN_TRACKING_CONFIDENCE=0.5

# FFMPEG
FFMPEG_PATH=ffmpeg
VIDEO_OUTPUT_WIDTH=1280
VIDEO_OUTPUT_HEIGHT=720
AVATAR_RENDER_SIZE=512

# WEBSOCKET
WS_HEARTBEAT_INTERVAL=30

# LOGGING
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
